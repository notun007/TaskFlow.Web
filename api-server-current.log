      SELECT "s"."Id", "s"."Name", "s"."BusinessOwner", "s"."TechnicalOwner", "s"."Criticality", "s"."Technology", "s"."CurrentVersion", "s"."IsProduction", "s"."IsThirdParty", "v"."Name", (
          SELECT COUNT(*)
          FROM "TASKFLOW"."Projects" "p"
          WHERE ((NOT ("p"."IsDeleted" <> 0 )) AND ("p"."SoftwareApplicationId" = "s"."Id"))), (
          SELECT COUNT(*)
          FROM "TASKFLOW"."TASKS" "t"
          WHERE ((NOT ("t"."IsDeleted" <> 0 )) AND (((((((NOT ("t"."IsDeleted" <> 0 )) AND ("t"."SoftwareApplicationId" = "s"."Id"))) AND ("t"."Status" <> N'Closed'))) AND ("t"."Status" <> N'Cancelled')))))
      FROM "TASKFLOW"."SoftwareApplications" "s"
      LEFT JOIN "TASKFLOW"."Vendors" "v" ON "s"."VendorId" = "v"."Id"
      WHERE NOT ("s"."IsDeleted" <> 0 )
      ORDER BY "s"."Name"
